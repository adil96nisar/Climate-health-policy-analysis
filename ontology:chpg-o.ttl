@prefix chpg: <https://example.org/chpg-o#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

#################################################################
# 1. ONTOLOGY: CHPG-O
#################################################################

chpg:CHPG_Ontology
    rdf:type owl:Ontology ;
    rdfs:label "CHPG-O: Climate-Health Policy Gap Ontology" ;
    rdfs:comment "A machine-operable ontology-based knowledge graph for climate-health policy gap and coherence analysis. It structures news evidence, policy evidence, external memory evidence, WHO alignment, policy strength, media concern, evidence availability, scoring, gap/coherence status, and traceable final reasoning." .

#################################################################
# 2. CORE CLASSES
#################################################################

chpg:SourceDocument rdf:type owl:Class ;
    rdfs:label "Source Document" ;
    rdfs:comment "Any document used as evidence in the knowledge graph." .

chpg:NewsArticle rdf:type owl:Class ;
    rdfs:subClassOf chpg:SourceDocument ;
    rdfs:label "News Article" ;
    rdfs:comment "A media source that reports climate-health concern." .

chpg:PolicyDocument rdf:type owl:Class ;
    rdfs:subClassOf chpg:SourceDocument ;
    rdfs:label "Policy Document" ;
    rdfs:comment "A policy, plan, strategy, law, guideline, report, or official framework." .

chpg:ExternalMemory rdf:type owl:Class ;
    rdfs:label "External Memory" ;
    rdfs:comment "Recent, verified, source-grounded, or high-confidence evidence used to confirm, update, contradict, or refine ontology reasoning." .

chpg:InternalMemory rdf:type owl:Class ;
    rdfs:label "Internal Memory" ;
    rdfs:comment "System-generated interpretation or earlier reasoning that must remain traceable to external evidence." .

chpg:EvidenceClaim rdf:type owl:Class ;
    rdfs:label "Evidence Claim" ;
    rdfs:comment "A source-grounded claim extracted from news, policy, or external memory evidence." .

chpg:ClimateHazard rdf:type owl:Class ;
    rdfs:label "Climate Hazard" ;
    rdfs:comment "A climate-related hazard such as heat, flood, cyclone, drought, salinity intrusion, air pollution, sea-level rise, or wildfire smoke." .

chpg:EnvironmentalDeterminant rdf:type owl:Class ;
    rdfs:label "Environmental Determinant" ;
    rdfs:comment "A pathway through which climate or environment affects health, such as WASH, air quality, food security, housing, workplace exposure, ecosystem change, or health facility resilience." .

chpg:HealthRisk rdf:type owl:Class ;
    rdfs:label "Health Risk" ;
    rdfs:comment "A climate-sensitive disease, condition, or health risk." .

chpg:HealthOutcome rdf:type owl:Class ;
    rdfs:label "Health Outcome" ;
    rdfs:comment "A health consequence such as illness, death, injury, malnutrition, mental stress, displacement, service disruption, or reduced labour capacity." .

chpg:VulnerableGroup rdf:type owl:Class ;
    rdfs:label "Vulnerable Group" ;
    rdfs:comment "A population group facing higher exposure, sensitivity, or lower adaptive capacity." .

chpg:GeographicArea rdf:type owl:Class ;
    rdfs:label "Geographic Area" ;
    rdfs:comment "A country, district, city, coastal area, rural area, urban area, or other location." .

chpg:Institution rdf:type owl:Class ;
    rdfs:label "Institution" ;
    rdfs:comment "An organization or actor responsible for policy, implementation, evidence, response, or reporting." .

chpg:PolicyMeasure rdf:type owl:Class ;
    rdfs:label "Policy Measure" ;
    rdfs:comment "A policy action, programme, intervention, target, recommendation, strategy, or implementation mechanism." .

chpg:WHOComponent rdf:type owl:Class ;
    rdfs:label "WHO Climate-Health System Component" ;
    rdfs:comment "A component of WHO climate-resilient and low-carbon health-system guidance." .

chpg:WHOBuildingBlock rdf:type owl:Class ;
    rdfs:label "WHO Health-System Building Block" ;
    rdfs:comment "A WHO health-system building block linked to climate-health resilience." .

chpg:GlobalActionArea rdf:type owl:Class ;
    rdfs:label "Global Action Area" ;
    rdfs:comment "A global climate-health action area from WHO or UN climate-health guidance." .

chpg:Sector rdf:type owl:Class ;
    rdfs:label "Sector" ;
    rdfs:comment "A sector involved in policy planning, implementation, or accountability." .

chpg:ImplementationLevel rdf:type owl:Class ;
    rdfs:label "Implementation Level" ;
    rdfs:comment "The level at which a policy measure is planned or implemented." .

chpg:PolicyInstrument rdf:type owl:Class ;
    rdfs:label "Policy Instrument" ;
    rdfs:comment "The instrument used to implement a policy measure." .

chpg:EvidenceCategory rdf:type owl:Class ;
    rdfs:label "Evidence Category" ;
    rdfs:comment "The type or authority level of evidence used in the knowledge graph." .

chpg:PolicyAssessment rdf:type owl:Class ;
    rdfs:label "Policy Assessment" ;
    rdfs:comment "A general assessment result produced after comparing news evidence, policy evidence, WHO/UN alignment, ontology rules, and external memory. It can represent gap, coherence, partial alignment, missing evidence, or policy-only alignment." .

chpg:PolicyGap rdf:type owl:Class ;
    rdfs:subClassOf chpg:PolicyAssessment ;
    rdfs:label "Policy Gap" ;
    rdfs:comment "A policy assessment where media concern is stronger than policy response and a real gap is detected." .

chpg:GapType rdf:type owl:Class ;
    rdfs:label "Gap Type" ;
    rdfs:comment "The type of policy gap detected through ontology reasoning." .

chpg:GapStatus rdf:type owl:Class ;
    rdfs:label "Policy gap/coherence status" ;
    rdfs:comment "Final status after checking available evidence, scores, ontology rules, and external memory." .

chpg:ReasoningRule rdf:type owl:Class ;
    rdfs:label "Reasoning Rule" ;
    rdfs:comment "A machine-readable policy-logic rule used for alignment, scoring, gap/coherence detection, external memory recheck, or final result generation." .

chpg:WorkflowRun rdf:type owl:Class ;
    rdfs:label "Workflow Run" ;
    rdfs:comment "One complete reasoning workflow from evidence checking to final result." .

chpg:WorkflowStep rdf:type owl:Class ;
    rdfs:label "Workflow Step" ;
    rdfs:comment "A step in the controlled ontology-guided reasoning workflow." .

chpg:NewsEvidenceCheck rdf:type owl:Class ;
    rdfs:subClassOf chpg:WorkflowStep ;
    rdfs:label "News Evidence Check" .

chpg:PolicyEvidenceCheck rdf:type owl:Class ;
    rdfs:subClassOf chpg:WorkflowStep ;
    rdfs:label "Policy Evidence Check" .

chpg:OntologyReasoningStep rdf:type owl:Class ;
    rdfs:subClassOf chpg:WorkflowStep ;
    rdfs:label "Ontology Reasoning Step" .

chpg:ExternalMemoryRecheck rdf:type owl:Class ;
    rdfs:subClassOf chpg:WorkflowStep ;
    rdfs:label "External Memory Recheck" .

chpg:FinalResult rdf:type owl:Class ;
    rdfs:label "Final Result" ;
    rdfs:comment "The final traceable output after news evidence, policy evidence, ontology reasoning, and external memory recheck." .

chpg:EvidenceStatus rdf:type owl:Class ;
    rdfs:label "Evidence Status" ;
    rdfs:comment "The status of evidence after validation, comparison, and rechecking." .

#################################################################
# 3. OBJECT PROPERTIES
#################################################################

chpg:hasEvidenceClaim rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:SourceDocument ;
    rdfs:range chpg:EvidenceClaim ;
    rdfs:label "has evidence claim" .

chpg:extractedFrom rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:EvidenceClaim ;
    rdfs:range chpg:SourceDocument ;
    rdfs:label "extracted from" .

chpg:storedIn rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:EvidenceClaim ;
    rdfs:range chpg:ExternalMemory ;
    rdfs:label "stored in external memory" .

chpg:derivedFrom rdf:type owl:ObjectProperty ;
    rdfs:range chpg:ExternalMemory ;
    rdfs:label "derived from source-grounded evidence" .

chpg:overriddenBy rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:InternalMemory ;
    rdfs:range chpg:ExternalMemory ;
    rdfs:label "overridden by stronger evidence" .

chpg:confirmsClaim rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemory ;
    rdfs:range chpg:EvidenceClaim ;
    rdfs:label "confirms claim" .

chpg:updatesClaim rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemory ;
    rdfs:range chpg:EvidenceClaim ;
    rdfs:label "updates claim" .

chpg:contradictsClaim rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemory ;
    rdfs:range chpg:EvidenceClaim ;
    rdfs:label "contradicts claim" .

chpg:replacesClaim rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:EvidenceClaim ;
    rdfs:range chpg:EvidenceClaim ;
    rdfs:label "replaces claim" .

chpg:mentionsHazard rdf:type owl:ObjectProperty ;
    rdfs:range chpg:ClimateHazard ;
    rdfs:label "mentions climate hazard" .

chpg:mentionsDeterminant rdf:type owl:ObjectProperty ;
    rdfs:range chpg:EnvironmentalDeterminant ;
    rdfs:label "mentions environmental determinant" .

chpg:reportsRisk rdf:type owl:ObjectProperty ;
    rdfs:range chpg:HealthRisk ;
    rdfs:label "reports health risk" .

chpg:causesRisk rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ClimateHazard ;
    rdfs:range chpg:HealthRisk ;
    rdfs:label "causes or contributes to health risk" .

chpg:mediatedBy rdf:type owl:ObjectProperty ;
    rdfs:range chpg:EnvironmentalDeterminant ;
    rdfs:label "mediated by environmental determinant" .

chpg:hasOutcome rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:HealthRisk ;
    rdfs:range chpg:HealthOutcome ;
    rdfs:label "has health outcome" .

chpg:affectsGroup rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:HealthRisk ;
    rdfs:range chpg:VulnerableGroup ;
    rdfs:label "affects vulnerable group" .

chpg:occursIn rdf:type owl:ObjectProperty ;
    rdfs:range chpg:GeographicArea ;
    rdfs:label "occurs in geographic area" .

chpg:issuedBy rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyDocument ;
    rdfs:range chpg:Institution ;
    rdfs:label "issued by institution" .

chpg:containsMeasure rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyDocument ;
    rdfs:range chpg:PolicyMeasure ;
    rdfs:label "contains policy measure" .

chpg:addressesRisk rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyMeasure ;
    rdfs:range chpg:HealthRisk ;
    rdfs:label "addresses health risk" .

chpg:targetsGroup rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyMeasure ;
    rdfs:range chpg:VulnerableGroup ;
    rdfs:label "targets vulnerable group" .

chpg:implementedBy rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyMeasure ;
    rdfs:range chpg:Institution ;
    rdfs:label "implemented by institution" .

chpg:involvesSector rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyMeasure ;
    rdfs:range chpg:Sector ;
    rdfs:label "involves sector" .

chpg:implementedAtLevel rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyMeasure ;
    rdfs:range chpg:ImplementationLevel ;
    rdfs:label "implemented at level" .

chpg:usesInstrument rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyMeasure ;
    rdfs:range chpg:PolicyInstrument ;
    rdfs:label "uses policy instrument" .

chpg:hasEvidenceCategory rdf:type owl:ObjectProperty ;
    rdfs:range chpg:EvidenceCategory ;
    rdfs:label "has evidence category" .

chpg:alignsWithWHOComponent rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyMeasure ;
    rdfs:range chpg:WHOComponent ;
    rdfs:label "aligns with WHO component" .

chpg:belongsToBuildingBlock rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:WHOComponent ;
    rdfs:range chpg:WHOBuildingBlock ;
    rdfs:label "belongs to WHO building block" .

chpg:supportsActionArea rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyMeasure ;
    rdfs:range chpg:GlobalActionArea ;
    rdfs:label "supports global action area" .

chpg:hasAssessment rdf:type owl:ObjectProperty ;
    rdfs:range chpg:PolicyAssessment ;
    rdfs:label "has policy assessment" .

chpg:hasGap rdf:type owl:ObjectProperty ;
    rdfs:range chpg:PolicyGap ;
    rdfs:label "has policy gap" .

chpg:relatedRisk rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyAssessment ;
    rdfs:range chpg:HealthRisk ;
    rdfs:label "related health risk" .

chpg:relatedGroup rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyAssessment ;
    rdfs:range chpg:VulnerableGroup ;
    rdfs:label "related vulnerable group" .

chpg:relatedWHOComponent rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyAssessment ;
    rdfs:range chpg:WHOComponent ;
    rdfs:label "related WHO component" .

chpg:gapType rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyAssessment ;
    rdfs:range chpg:GapType ;
    rdfs:label "gap type" .

chpg:hasPrimaryGapType rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyAssessment ;
    rdfs:range chpg:GapType ;
    rdfs:label "has primary gap type" ;
    rdfs:comment "The strongest gap type supported by direct evidence." .

chpg:hasSecondaryGapType rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyAssessment ;
    rdfs:range chpg:GapType ;
    rdfs:label "has secondary gap type" ;
    rdfs:comment "An optional second gap type supported by direct evidence." .

chpg:hasPolicyGapCoherenceStatus rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyAssessment ;
    rdfs:range chpg:GapStatus ;
    rdfs:label "has policy gap/coherence status" .

chpg:hasEvidenceStatus rdf:type owl:ObjectProperty ;
    rdfs:range chpg:EvidenceStatus ;
    rdfs:label "has evidence status" .

chpg:hasWorkflowStep rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:WorkflowRun ;
    rdfs:range chpg:WorkflowStep ;
    rdfs:label "has workflow step" .

chpg:nextStep rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:WorkflowStep ;
    rdfs:range chpg:WorkflowStep ;
    rdfs:label "next workflow step" .

chpg:checksNewsSource rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:NewsEvidenceCheck ;
    rdfs:range chpg:NewsArticle ;
    rdfs:label "checks news source" .

chpg:checksPolicySource rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:PolicyEvidenceCheck ;
    rdfs:range chpg:PolicyDocument ;
    rdfs:label "checks policy source" .

chpg:checksExternalMemory rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemoryRecheck ;
    rdfs:range chpg:ExternalMemory ;
    rdfs:label "checks external memory" .

chpg:usesEvidenceClaim rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:WorkflowStep ;
    rdfs:range chpg:EvidenceClaim ;
    rdfs:label "uses evidence claim" .

chpg:usesOntologyRule rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:OntologyReasoningStep ;
    rdfs:range chpg:ReasoningRule ;
    rdfs:label "uses ontology rule" .

chpg:producesAssessment rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:OntologyReasoningStep ;
    rdfs:range chpg:PolicyAssessment ;
    rdfs:label "produces policy assessment" .

chpg:producesGap rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:OntologyReasoningStep ;
    rdfs:range chpg:PolicyGap ;
    rdfs:label "produces policy gap" .

chpg:producesFinalResult rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:WorkflowRun ;
    rdfs:range chpg:FinalResult ;
    rdfs:label "produces final result" .

chpg:finalizesAssessment rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:FinalResult ;
    rdfs:range chpg:PolicyAssessment ;
    rdfs:label "finalizes policy assessment" .

chpg:finalizesGap rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:FinalResult ;
    rdfs:range chpg:PolicyGap ;
    rdfs:label "finalizes policy gap" .

chpg:externalMemorySupportsRisk rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemory ;
    rdfs:range chpg:HealthRisk ;
    rdfs:label "external memory supports health risk" .

chpg:externalMemorySupportsHazard rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemory ;
    rdfs:range chpg:ClimateHazard ;
    rdfs:label "external memory supports climate hazard" .

chpg:externalMemorySupportsGroup rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemory ;
    rdfs:range chpg:VulnerableGroup ;
    rdfs:label "external memory supports vulnerable group" .

chpg:externalMemorySupportsWHOComponent rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemory ;
    rdfs:range chpg:WHOComponent ;
    rdfs:label "external memory supports WHO component" .

chpg:externalMemorySupportsGapType rdf:type owl:ObjectProperty ;
    rdfs:domain chpg:ExternalMemory ;
    rdfs:range chpg:GapType ;
    rdfs:label "external memory supports gap type" .

#################################################################
# 4. DATA PROPERTIES
#################################################################

chpg:sourceTitle rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
chpg:sourceType rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
chpg:sourceDate rdf:type owl:DatatypeProperty ; rdfs:range xsd:date .
chpg:sourceURI rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
chpg:claimText rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
chpg:evidenceQuote rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
chpg:confidenceScore rdf:type owl:DatatypeProperty ; rdfs:range xsd:decimal .
chpg:freshnessScore rdf:type owl:DatatypeProperty ; rdfs:range xsd:decimal .
chpg:evidencePriority rdf:type owl:DatatypeProperty ; rdfs:range xsd:integer .
chpg:mediaConcernScore rdf:type owl:DatatypeProperty ; rdfs:range xsd:integer .
chpg:policyStrengthScore rdf:type owl:DatatypeProperty ; rdfs:range xsd:integer .
chpg:whoAlignmentScore rdf:type owl:DatatypeProperty ; rdfs:range xsd:integer .
chpg:gapMediaConcern rdf:type owl:DatatypeProperty ; rdfs:range xsd:integer .
chpg:gapPolicyStrength rdf:type owl:DatatypeProperty ; rdfs:range xsd:integer .
chpg:gapDifference rdf:type owl:DatatypeProperty ; rdfs:range xsd:integer .
chpg:gapSeverity rdf:type owl:DatatypeProperty ; rdfs:range xsd:integer .
chpg:reasoningNote rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
chpg:evidenceAvailabilityNote rdf:type owl:DatatypeProperty ; rdfs:range xsd:string .
chpg:newsEvidenceAvailable rdf:type owl:DatatypeProperty ; rdfs:domain chpg:PolicyAssessment ; rdfs:range xsd:boolean .
chpg:policyEvidenceAvailable rdf:type owl:DatatypeProperty ; rdfs:domain chpg:PolicyAssessment ; rdfs:range xsd:boolean .
chpg:externalMemoryAvailable rdf:type owl:DatatypeProperty ; rdfs:domain chpg:PolicyAssessment ; rdfs:range xsd:boolean .
chpg:externalMemoryDate rdf:type owl:DatatypeProperty ; rdfs:domain chpg:ExternalMemory ; rdfs:range xsd:date .
chpg:externalMemoryEvidenceUse rdf:type owl:DatatypeProperty ; rdfs:domain chpg:ExternalMemory ; rdfs:range xsd:string .
chpg:workflowDate rdf:type owl:DatatypeProperty ; rdfs:domain chpg:WorkflowRun ; rdfs:range xsd:date .
chpg:stepOrder rdf:type owl:DatatypeProperty ; rdfs:domain chpg:WorkflowStep ; rdfs:range xsd:integer .
chpg:finalResultText rdf:type owl:DatatypeProperty ; rdfs:domain chpg:FinalResult ; rdfs:range xsd:string .
chpg:hasCondition rdf:type owl:DatatypeProperty ; rdfs:domain chpg:ReasoningRule ; rdfs:range xsd:string .
chpg:hasConclusion rdf:type owl:DatatypeProperty ; rdfs:domain chpg:ReasoningRule ; rdfs:range xsd:string .
chpg:hasPolicyLogic rdf:type owl:DatatypeProperty ; rdfs:domain chpg:ReasoningRule ; rdfs:range xsd:string .

#################################################################
# 5. WHO COMPONENTS AND BUILDING BLOCKS
#################################################################

chpg:BB1_ServiceDelivery rdf:type chpg:WHOBuildingBlock ; rdfs:label "Service Delivery" .
chpg:BB2_HealthWorkforce rdf:type chpg:WHOBuildingBlock ; rdfs:label "Health Workforce" .
chpg:BB3_HealthInformationSystems rdf:type chpg:WHOBuildingBlock ; rdfs:label "Health Information Systems" .
chpg:BB4_MedicalProductsTechnologies rdf:type chpg:WHOBuildingBlock ; rdfs:label "Medical Products and Technologies" .
chpg:BB5_HealthFinancing rdf:type chpg:WHOBuildingBlock ; rdfs:label "Health Financing" .
chpg:BB6_LeadershipGovernance rdf:type chpg:WHOBuildingBlock ; rdfs:label "Leadership and Governance" .

chpg:C1_LeadershipAndGovernance rdf:type chpg:WHOComponent ;
    rdfs:label "C1 Climate-transformative leadership and governance" ;
    chpg:belongsToBuildingBlock chpg:BB6_LeadershipGovernance .

chpg:C2_HealthWorkforce rdf:type chpg:WHOComponent ;
    rdfs:label "C2 Climate-smart health workforce" ;
    chpg:belongsToBuildingBlock chpg:BB2_HealthWorkforce .

chpg:C3_VulnerabilityCapacityAdaptationAssessment rdf:type chpg:WHOComponent ;
    rdfs:label "C3 Assessments of climate and health risks and GHG emissions" ;
    chpg:belongsToBuildingBlock chpg:BB3_HealthInformationSystems .

chpg:C4_IntegratedRiskMonitoringEarlyWarning rdf:type chpg:WHOComponent ;
    rdfs:label "C4 Integrated risks monitoring, early warning and GHG emissions tracking" ;
    chpg:belongsToBuildingBlock chpg:BB3_HealthInformationSystems .

chpg:C5_HealthAndClimateResearch rdf:type chpg:WHOComponent ;
    rdfs:label "C5 Health and climate research" ;
    chpg:belongsToBuildingBlock chpg:BB3_HealthInformationSystems .

chpg:C6_ClimateResilientInfrastructureTechnology rdf:type chpg:WHOComponent ;
    rdfs:label "C6 Climate-resilient and low-carbon infrastructures, technologies and supply chain" ;
    chpg:belongsToBuildingBlock chpg:BB4_MedicalProductsTechnologies .

chpg:C7_EnvironmentalDeterminantsHealthManagement rdf:type chpg:WHOComponent ;
    rdfs:label "C7 Management of environmental determinants of health" ;
    chpg:belongsToBuildingBlock chpg:BB1_ServiceDelivery .

chpg:C8_ClimateInformedHealthProgrammes rdf:type chpg:WHOComponent ;
    rdfs:label "C8 Climate-informed health programmes" ;
    chpg:belongsToBuildingBlock chpg:BB1_ServiceDelivery .

chpg:C9_EmergencyPreparednessManagement rdf:type chpg:WHOComponent ;
    rdfs:label "C9 Climate-related emergency preparedness and management" ;
    chpg:belongsToBuildingBlock chpg:BB1_ServiceDelivery .

chpg:C10_ClimateAndHealthFinancing rdf:type chpg:WHOComponent ;
    rdfs:label "C10 Sustainable climate and health financing" ;
    chpg:belongsToBuildingBlock chpg:BB5_HealthFinancing .

#################################################################
# 6. GLOBAL ACTION AREAS
#################################################################

chpg:LeadershipCoordinationAdvocacy rdf:type chpg:GlobalActionArea ; rdfs:label "Leadership, coordination and advocacy" .
chpg:EvidenceAndMonitoring rdf:type chpg:GlobalActionArea ; rdfs:label "Evidence and monitoring" .
chpg:CountryLevelActionCapacityBuilding rdf:type chpg:GlobalActionArea ; rdfs:label "Country-level action and capacity-building" .
chpg:ClimateHealthFinance rdf:type chpg:GlobalActionArea ; rdfs:label "Climate and health finance" .
chpg:ClimateResilientLowCarbonHealthSystems rdf:type chpg:GlobalActionArea ; rdfs:label "Climate-resilient and low-carbon health systems" .

#################################################################
# 7. UNIVERSAL CONTROLLED CONCEPTS
#################################################################

chpg:ExtremeHeat rdf:type chpg:ClimateHazard ; rdfs:label "Extreme heat" .
chpg:Flood rdf:type chpg:ClimateHazard ; rdfs:label "Flood" .
chpg:Cyclone rdf:type chpg:ClimateHazard ; rdfs:label "Cyclone" .
chpg:Drought rdf:type chpg:ClimateHazard ; rdfs:label "Drought" .
chpg:SalinityIntrusion rdf:type chpg:ClimateHazard ; rdfs:label "Salinity intrusion" .
chpg:AirPollution rdf:type chpg:ClimateHazard ; rdfs:label "Air pollution" .
chpg:SeaLevelRise rdf:type chpg:ClimateHazard ; rdfs:label "Sea-level rise" .
chpg:WildfireSmoke rdf:type chpg:ClimateHazard ; rdfs:label "Wildfire smoke" .

chpg:WASH rdf:type chpg:EnvironmentalDeterminant ; rdfs:label "Water, sanitation and hygiene" .
chpg:AirQuality rdf:type chpg:EnvironmentalDeterminant ; rdfs:label "Air quality" .
chpg:FoodSecurity rdf:type chpg:EnvironmentalDeterminant ; rdfs:label "Food security" .
chpg:HousingCondition rdf:type chpg:EnvironmentalDeterminant ; rdfs:label "Housing condition" .
chpg:WorkplaceExposure rdf:type chpg:EnvironmentalDeterminant ; rdfs:label "Workplace exposure" .
chpg:HealthFacilityResilience rdf:type chpg:EnvironmentalDeterminant ; rdfs:label "Health facility resilience" .
chpg:EcosystemChange rdf:type chpg:EnvironmentalDeterminant ; rdfs:label "Ecosystem change" .

chpg:HeatStress rdf:type chpg:HealthRisk ; rdfs:label "Heat stress" .
chpg:Dengue rdf:type chpg:HealthRisk ; rdfs:label "Dengue" .
chpg:Malaria rdf:type chpg:HealthRisk ; rdfs:label "Malaria" .
chpg:DiarrhoealDisease rdf:type chpg:HealthRisk ; rdfs:label "Diarrhoeal disease" .
