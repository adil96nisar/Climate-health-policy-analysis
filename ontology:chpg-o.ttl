#################################################################
# 9. GAP TYPES, STATUS, AND EVIDENCE STATUS
#################################################################

chpg:DesignGap rdf:type chpg:GapType ;
    rdfs:label "Design gap" ;
    rdfs:comment "The policy does not frame the problem properly or is based on incomplete assumptions." .

chpg:ImplementationGap rdf:type chpg:GapType ;
    rdfs:label "Implementation gap" ;
    rdfs:comment "The policy exists but lacks actor, delivery mechanism, instrument, monitoring, or finance." .

chpg:CoverageGap rdf:type chpg:GapType ;
    rdfs:label "Coverage gap" ;
    rdfs:comment "The policy excludes a relevant risk, group, region, sector, or determinant." .

chpg:OutcomeGap rdf:type chpg:GapType ;
    rdfs:label "Outcome gap" ;
    rdfs:comment "The policy exists but evidence does not show intended results." .

chpg:EquityGap rdf:type chpg:GapType ;
    rdfs:label "Equity gap" ;
    rdfs:comment "The burden and policy benefit are unevenly distributed across groups." .

chpg:NoPolicyGapDetected rdf:type chpg:GapStatus ;
    rdfs:label "No policy gap detected / Policy coherence found" ;
    rdfs:comment "News evidence and policy evidence are both available, policy response is equal to or stronger than news concern, and no strong gap-type rule fires." .

chpg:PartialPolicyCoherence rdf:type chpg:GapStatus ;
    rdfs:label "Partial policy coherence / Minor policy gap" ;
    rdfs:comment "News and policy evidence are both available, but policy response is partial or some limitation is detected, such as missing monitoring, finance, vulnerable group, geographic targeting, or outcome evidence." .

chpg:ModeratePolicyGap rdf:type chpg:GapStatus ;
    rdfs:label "Moderate policy gap" ;
    rdfs:comment "News concern is clearly stronger than policy response, producing a moderate gap." .

chpg:CriticalPolicyGap rdf:type chpg:GapStatus ;
    rdfs:label "Critical policy gap" ;
    rdfs:comment "News concern is strong or urgent, while policy response is absent or very weak." .

chpg:PolicyEvidenceMissing rdf:type chpg:GapStatus ;
    rdfs:label "Policy evidence missing" ;
    rdfs:comment "Relevant news evidence exists, but no matching policy evidence is retrieved from the policy corpus." .

chpg:NewsEvidenceMissing rdf:type chpg:GapStatus ;
    rdfs:label "News evidence missing" ;
    rdfs:comment "Relevant policy evidence exists, but no matching news evidence is retrieved from the news corpus." .

chpg:PolicyOnlyAlignment rdf:type chpg:GapStatus ;
    rdfs:label "Policy-only alignment" ;
    rdfs:comment "Policy or WHO/UN framework evidence exists, but news-policy comparison is not possible because no relevant news evidence is available." .

chpg:OnlyNewsFound rdf:type chpg:GapStatus ;
    rdfs:label "Only news found / Policy evidence not retrieved" ;
    rdfs:comment "News evidence is available, but policy evidence, WHO alignment, or external memory is missing or insufficient. This is a potential concern, not a confirmed policy gap." .

chpg:EvidenceInsufficient rdf:type chpg:GapStatus ;
    rdfs:label "Evidence insufficient" ;
    rdfs:comment "There is not enough news, policy, or external memory evidence to make a gap or coherence claim." .

chpg:PolicyLimitation rdf:type chpg:GapStatus ;
    rdfs:label "Policy limitation" ;
    rdfs:comment "A weakness is detected in policy design or implementation, but the evidence is not strong enough to classify it as a confirmed policy gap." .

chpg:UncheckedEvidence rdf:type chpg:EvidenceStatus ; rdfs:label "Unchecked evidence" .
chpg:SourceGroundedEvidence rdf:type chpg:EvidenceStatus ; rdfs:label "Source-grounded evidence" .
chpg:UpdatedEvidence rdf:type chpg:EvidenceStatus ; rdfs:label "Updated evidence" .
chpg:ContradictedEvidence rdf:type chpg:EvidenceStatus ; rdfs:label "Contradicted evidence" .
chpg:ConfirmedEvidence rdf:type chpg:EvidenceStatus ; rdfs:label "Confirmed evidence" .
chpg:UncertainEvidence rdf:type chpg:EvidenceStatus ; rdfs:label "Uncertain evidence" .

#################################################################
# 10. UNIVERSAL CAUSAL LINKS
#################################################################

chpg:ExtremeHeat chpg:causesRisk chpg:HeatStress , chpg:Dehydration , chpg:OccupationalHealthRisk ;
    chpg:mediatedBy chpg:WorkplaceExposure .

chpg:Flood chpg:causesRisk chpg:DiarrhoealDisease , chpg:HealthServiceDisruption ;
    chpg:mediatedBy chpg:WASH , chpg:HealthFacilityResilience .

chpg:Cyclone chpg:causesRisk chpg:InjuryRisk , chpg:HealthServiceDisruption ;
    chpg:mediatedBy chpg:HealthFacilityResilience .

chpg:SalinityIntrusion chpg:causesRisk chpg:DiarrhoealDisease , chpg:SkinInfection , chpg:CardiometabolicDisease ;
    chpg:mediatedBy chpg:WASH .

chpg:AirPollution chpg:causesRisk chpg:RespiratoryDisease , chpg:MaternalHealthRisk ;
    chpg:mediatedBy chpg:AirQuality .

chpg:Drought chpg:causesRisk chpg:Malnutrition ;
    chpg:mediatedBy chpg:FoodSecurity .

chpg:SeaLevelRise chpg:causesRisk chpg:MentalHealthRisk , chpg:ReproductiveHealthRisk ;
    chpg:mediatedBy chpg:HousingCondition .

chpg:HeatStress chpg:affectsGroup chpg:OutdoorWorkers , chpg:ElderlyPeople , chpg:PregnantWomen ;
    chpg:hasOutcome chpg:ReducedLabourCapacity .

chpg:Dengue chpg:affectsGroup chpg:UrbanPoor , chpg:Children ;
    chpg:hasOutcome chpg:Illness .

chpg:DiarrhoealDisease chpg:affectsGroup chpg:Children , chpg:CoastalCommunities ;
    chpg:hasOutcome chpg:Illness .

chpg:RespiratoryDisease chpg:affectsGroup chpg:Children , chpg:ElderlyPeople ;
    chpg:hasOutcome chpg:Illness .

chpg:MaternalHealthRisk chpg:affectsGroup chpg:PregnantWomen , chpg:Women ;
    chpg:hasOutcome chpg:Illness .

chpg:ReproductiveHealthRisk chpg:affectsGroup chpg:Women , chpg:PregnantWomen , chpg:AdolescentGirls , chpg:CoastalCommunities ;
    chpg:hasOutcome chpg:Illness .

chpg:MentalHealthRisk chpg:affectsGroup chpg:DisasterAffectedPeople ;
    chpg:hasOutcome chpg:Illness .

chpg:HealthServiceDisruption chpg:affectsGroup chpg:CoastalCommunities , chpg:PersonsWithDisabilities ;
    chpg:hasOutcome chpg:ServiceInterruption .

#################################################################
# 11. CORE REASONING RULES
#################################################################

chpg:Rule_01_NewsFirst rdf:type chpg:ReasoningRule ;
    rdfs:label "News-first evidence rule" ;
    chpg:hasCondition "NewsArticle reports HealthRisk, ClimateHazard, VulnerableGroup, or GeographicArea" ;
    chpg:hasConclusion "Create EvidenceClaim and assign mediaConcernScore" ;
    chpg:hasPolicyLogic "News evidence identifies public or media concern before policy adequacy is judged." .

chpg:Rule_02_PolicySecond rdf:type chpg:ReasoningRule ;
    rdfs:label "Policy-second evidence rule" ;
    chpg:hasCondition "PolicyDocument contains PolicyMeasure addressing the same HealthRisk, VulnerableGroup, GeographicArea, or WHOComponent" ;
    chpg:hasConclusion "Create PolicyMeasure and assign policyStrengthScore and whoAlignmentScore" ;
    chpg:hasPolicyLogic "Policy evidence is checked after news evidence to determine whether the reported concern is addressed." .

chpg:Rule_03_ReasoningAfterComparison rdf:type chpg:ReasoningRule ;
    rdfs:label "Reasoning after comparison rule" ;
    chpg:hasCondition "mediaConcernScore and policyStrengthScore are available for the same HealthRisk, VulnerableGroup, or WHOComponent" ;
    chpg:hasConclusion "Run gap/coherence status detection and classify only directly supported gap types" ;
    chpg:hasPolicyLogic "Ontology reasoning starts only after the evidence availability check and comparison are completed." .

chpg:Rule_04_BasicGapDetection rdf:type chpg:ReasoningRule ;
    rdfs:label "Basic policy gap detection" ;
    chpg:hasCondition "newsEvidenceAvailable = true AND policyEvidenceAvailable = true AND gapMediaConcern > gapPolicyStrength" ;
    chpg:hasConclusion "Create PolicyGap" ;
    chpg:hasPolicyLogic "A confirmed policy gap exists only when news concern is stronger than policy response and both evidence types are available." .

chpg:Rule_05_GapDifferenceCalculation rdf:type chpg:ReasoningRule ;
    rdfs:label "Gap difference calculation" ;
    chpg:hasCondition "gapMediaConcern and gapPolicyStrength are known" ;
    chpg:hasConclusion "gapDifference = gapMediaConcern - gapPolicyStrength" ;
    chpg:hasPolicyLogic "Raw gap difference is calculated by subtracting policy strength from media concern." .

chpg:Rule_06_GapSeverityNormalization rdf:type chpg:ReasoningRule ;
    rdfs:label "Gap severity normalization" ;
    chpg:hasCondition "gapDifference is known" ;
    chpg:hasConclusion "If gapDifference <= 0 then gapSeverity = 0; if gapDifference > 0 then gapSeverity = gapDifference" ;
    chpg:hasPolicyLogic "Gap severity is never negative. Negative difference means no detected policy gap." .

chpg:Rule_07_CoverageGap rdf:type chpg:ReasoningRule ;
    rdfs:label "Coverage gap rule" ;
    chpg:hasCondition "Both news and policy evidence are available; HealthRisk affects VulnerableGroup; policy response exists but no PolicyMeasure targets that VulnerableGroup for that HealthRisk" ;
    chpg:hasConclusion "gapType = CoverageGap" ;
    chpg:hasPolicyLogic "A coverage gap requires direct evidence that the policy excludes a relevant risk, group, region, sector, or determinant." .

chpg:Rule_08_ImplementationGap rdf:type chpg:ReasoningRule ;
    rdfs:label "Implementation gap rule" ;
    chpg:hasCondition "Both news and policy evidence are available; PolicyMeasure addresses HealthRisk but lacks implementedBy, implementedAtLevel, usesInstrument, monitoring, or finance" ;
    chpg:hasConclusion "gapType = ImplementationGap" ;
    chpg:hasPolicyLogic "A policy measure is weak when it does not explain who acts, where action happens, how action is delivered, how it is monitored, or how it is financed." .

chpg:Rule_09_DesignGap rdf:type chpg:ReasoningRule ;
    rdfs:label "Design gap rule" ;
    chpg:hasCondition "Both news and policy evidence are available; NewsArticle reports a specific HealthRisk and PolicyDocument mentions only broad climate-health concern without naming or operationalizing the HealthRisk" ;
    chpg:hasConclusion "gapType = DesignGap" ;
    chpg:hasPolicyLogic "A policy has a design gap when it fails to frame the specific problem visible in evidence." .

chpg:Rule_10_EquityGap rdf:type chpg:ReasoningRule ;
    rdfs:label "Equity gap rule" ;
    chpg:hasCondition "Both news and policy evidence are available; HealthRisk affects VulnerableGroup and PolicyMeasure targets GeneralPopulation only" ;
    chpg:hasConclusion "gapType = EquityGap" ;
    chpg:hasPolicyLogic "A policy has an equity gap when a specific vulnerable group is affected but the response remains general." .

chpg:Rule_11_OutcomeGap rdf:type chpg:ReasoningRule ;
    rdfs:label "Outcome gap rule" ;
    chpg:hasCondition "Both news and policy evidence are available; PolicyMeasure exists but no monitoring, indicator, review, evaluation, or outcome evidence is available" ;
    chpg:hasConclusion "gapType = OutcomeGap" ;
    chpg:hasPolicyLogic "A policy cannot prove results if it lacks monitoring or outcome evidence." .

chpg:Rule_12_ExternalMemoryRecheck rdf:type chpg:ReasoningRule ;
    rdfs:label "External memory recheck rule" ;
    chpg:hasCondition "ExternalMemory contains recent or higher-confidence evidence about the same HealthRisk, PolicyMeasure, VulnerableGroup, WHOComponent, or PolicyAssessment" ;
    chpg:hasConclusion "Confirm, update, contradict, or refine preliminary PolicyAssessment" ;
    chpg:hasPolicyLogic "Recent source-grounded evidence is used to improve the reasoning result before final output." .

chpg:Rule_13_RecentExternalMemoryPriority rdf:type chpg:ReasoningRule ;
    rdfs:label "Recent external memory priority rule" ;
    chpg:hasCondition "ExternalMemory is newer than existing evidence and has confidenceScore >= 0.80" ;
    chpg:hasConclusion "ExternalMemory can update EvidenceClaim, PolicyMeasure, policy gap/coherence status, gapSeverity, or reasoningNote" ;
    chpg:hasPolicyLogic "Newer and stronger external evidence should polish the result when information has changed." .

chpg:Rule_14_ExternalMemoryContradiction rdf:type chpg:ReasoningRule ;
    rdfs:label "External memory contradiction rule" ;
    chpg:hasCondition "ExternalMemory contradicts existing EvidenceClaim or PolicyAssessment and has higher confidenceScore" ;
    chpg:hasConclusion "Mark old claim as ContradictedEvidence and create updated claim" ;
    chpg:hasPolicyLogic "The graph preserves old reasoning but prevents contradicted evidence from being treated as final." .

chpg:Rule_15_FinalResult rdf:type chpg:ReasoningRule ;
    rdfs:label "Final result rule" ;
    chpg:hasCondition "PolicyAssessment has evidence availability status, scores, WHO alignment, ontology reasoning, and external memory recheck where available" ;
    chpg:hasConclusion "Create FinalResult" ;
    chpg:hasPolicyLogic "A final result is a traceable assessment and must not force a gap when evidence is missing." .

#################################################################
# 12. WHO ALIGNMENT RULES
#################################################################

chpg:Rule_C1_GovernanceAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C1 governance alignment" ;
    chpg:hasCondition "PolicyMeasure includes governance, coordination, accountability, mandate, focal point, national strategy, or intersectoral mechanism" ;
    chpg:hasConclusion "alignsWithWHOComponent = C1_LeadershipAndGovernance" .

chpg:Rule_C2_WorkforceAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C2 workforce alignment" ;
    chpg:hasCondition "PolicyMeasure includes training, curriculum, professional capacity, risk communication training, or health worker preparedness" ;
    chpg:hasConclusion "alignsWithWHOComponent = C2_HealthWorkforce" .

chpg:Rule_C3_AssessmentAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C3 vulnerability assessment alignment" ;
    chpg:hasCondition "PolicyMeasure includes vulnerability assessment, capacity assessment, adaptation assessment, risk mapping, baseline assessment, or identification of vulnerable groups" ;
    chpg:hasConclusion "alignsWithWHOComponent = C3_VulnerabilityCapacityAdaptationAssessment" .

chpg:Rule_C4_EarlyWarningAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C4 monitoring and early warning alignment" ;
    chpg:hasCondition "PolicyMeasure includes surveillance, climate data, meteorological data, early warning, risk monitoring, forecasting, dashboards, or climate-health bulletins" ;
    chpg:hasConclusion "alignsWithWHOComponent = C4_IntegratedRiskMonitoringEarlyWarning" .

chpg:Rule_C5_ResearchAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C5 research alignment" ;
    chpg:hasCondition "PolicyMeasure includes research agenda, evidence generation, data linkage, knowledge translation, or researcher-policy-maker collaboration" ;
    chpg:hasConclusion "alignsWithWHOComponent = C5_HealthAndClimateResearch" .

chpg:Rule_C6_InfrastructureAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C6 infrastructure alignment" ;
    chpg:hasCondition "PolicyMeasure includes resilient health facilities, climate-proof infrastructure, renewable energy, WASH in facilities, medical products, eHealth, low-carbon supply chain, or sustainable procurement" ;
    chpg:hasConclusion "alignsWithWHOComponent = C6_ClimateResilientInfrastructureTechnology" .

chpg:Rule_C7_EnvironmentalDeterminantsAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C7 environmental determinants alignment" ;
    chpg:hasCondition "PolicyMeasure addresses WASH, air quality, food safety, housing, workplace exposure, waste, ecosystem, chemicals, or environmental health determinant" ;
    chpg:hasConclusion "alignsWithWHOComponent = C7_EnvironmentalDeterminantsHealthManagement" .

chpg:Rule_C8_ProgrammeAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C8 climate-informed health programme alignment" ;
    chpg:hasCondition "PolicyMeasure integrates climate information into disease control, nutrition, vector control, heat-health, respiratory health, mental health, maternal health, or other health programme" ;
    chpg:hasConclusion "alignsWithWHOComponent = C8_ClimateInformedHealthProgrammes" .

chpg:Rule_C9_EmergencyPreparednessAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C9 emergency preparedness alignment" ;
    chpg:hasCondition "PolicyMeasure includes disaster risk reduction, emergency preparedness, contingency planning, rapid response, extreme weather plan, or health facility emergency plan" ;
    chpg:hasConclusion "alignsWithWHOComponent = C9_EmergencyPreparednessManagement" .

chpg:Rule_C10_FinancingAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "C10 financing alignment" ;
    chpg:hasCondition "PolicyMeasure includes budget, climate finance, health adaptation finance, donor proposal, multilateral finance, domestic finance, or resource mobilization" ;
    chpg:hasConclusion "alignsWithWHOComponent = C10_ClimateAndHealthFinancing" .

#################################################################
# 13. SCORING RULES
#################################################################

chpg:Rule_MediaConcern_0 rdf:type chpg:ReasoningRule ;
    rdfs:label "Media concern score 0" ;
    chpg:hasCondition "No NewsArticle reports the HealthRisk" ;
    chpg:hasConclusion "mediaConcernScore = 0" .

chpg:Rule_MediaConcern_1 rdf:type chpg:ReasoningRule ;
    rdfs:label "Media concern score 1" ;
    chpg:hasCondition "HealthRisk is mentioned weakly or once without clear affected group or location" ;
    chpg:hasConclusion "mediaConcernScore = 1" .

chpg:Rule_MediaConcern_2 rdf:type chpg:ReasoningRule ;
    rdfs:label "Media concern score 2" ;
    chpg:hasCondition "HealthRisk appears repeatedly or with clear affected group, hazard, or location" ;
    chpg:hasConclusion "mediaConcernScore = 2" .

chpg:Rule_MediaConcern_3 rdf:type chpg:ReasoningRule ;
    rdfs:label "Media concern score 3" ;
    chpg:hasCondition "HealthRisk appears as urgent, repeated, severe, or strongly linked to vulnerable groups, deaths, illness, disruption, or livelihood loss" ;
    chpg:hasConclusion "mediaConcernScore = 3" .

chpg:Rule_PolicyStrength_0 rdf:type chpg:ReasoningRule ;
    rdfs:label "Policy strength score 0" ;
    chpg:hasCondition "No PolicyMeasure addresses the reported HealthRisk" ;
    chpg:hasConclusion "policyStrengthScore = 0" .

chpg:Rule_PolicyStrength_1 rdf:type chpg:ReasoningRule ;
    rdfs:label "Policy strength score 1" ;
    chpg:hasCondition "PolicyDocument mentions HealthRisk generally but has no actor, target group, level, instrument, monitoring, or finance" ;
    chpg:hasConclusion "policyStrengthScore = 1" .

chpg:Rule_PolicyStrength_2 rdf:type chpg:ReasoningRule ;
    rdfs:label "Policy strength score 2" ;
    chpg:hasCondition "PolicyMeasure addresses HealthRisk and includes at least two of actor, target group, level, instrument, monitoring, or finance" ;
    chpg:hasConclusion "policyStrengthScore = 2" .

chpg:Rule_PolicyStrength_3 rdf:type chpg:ReasoningRule ;
    rdfs:label "Policy strength score 3" ;
    chpg:hasCondition "PolicyMeasure addresses HealthRisk and includes responsible actor, target group, implementation level, instrument, monitoring indicator, and finance or resource logic" ;
    chpg:hasConclusion "policyStrengthScore = 3" .

#################################################################
# 14. FINAL EVIDENCE-FIRST POLICY GAP / COHERENCE RULES
#################################################################

chpg:Rule_Final_01_EvidenceFirst rdf:type chpg:ReasoningRule ;
    rdfs:label "Final evidence-first rule" ;
    chpg:hasCondition "Before classifying gap or coherence, the system must check whether news evidence, policy evidence, and external memory evidence are available" ;
    chpg:hasConclusion "Assign an evidence-availability status before assigning any gap status" ;
    chpg:hasPolicyLogic "The system must not force a gap or coherence result when the required evidence is missing." .

chpg:Rule_Final_02_NoEvidence rdf:type chpg:ReasoningRule ;
    rdfs:label "No sufficient evidence rule" ;
    chpg:hasCondition "newsEvidenceAvailable = false AND policyEvidenceAvailable = false" ;
    chpg:hasConclusion "hasPolicyGapCoherenceStatus = EvidenceInsufficient" ;
    chpg:hasPolicyLogic "If neither news nor policy evidence is found, no gap or coherence claim can be made." .

chpg:Rule_Final_03_OnlyNewsFound rdf:type chpg:ReasoningRule ;
    rdfs:label "Only news found rule" ;
    chpg:hasCondition "newsEvidenceAvailable = true AND policyEvidenceAvailable = false" ;
    chpg:hasConclusion "hasPolicyGapCoherenceStatus = OnlyNewsFound OR PolicyEvidenceMissing" ;
    chpg:hasPolicyLogic "News evidence alone indicates public or media concern, but it is not enough to confirm a policy gap unless policy retrieval has been properly completed." .

chpg:Rule_Final_04_PolicyOnlyAlignment rdf:type chpg:ReasoningRule ;
    rdfs:label "Policy-only alignment rule" ;
    chpg:hasCondition "newsEvidenceAvailable = false AND policyEvidenceAvailable = true" ;
    chpg:hasConclusion "hasPolicyGapCoherenceStatus = PolicyOnlyAlignment OR NewsEvidenceMissing" ;
    chpg:hasPolicyLogic "Policy evidence alone can show policy alignment with WHO/UN frameworks, but it cannot show a news-policy gap." .

chpg:Rule_Final_05_GapDifferenceCalculation rdf:type chpg:ReasoningRule ;
    rdfs:label "Final gap difference calculation rule" ;
    chpg:hasCondition "newsEvidenceAvailable = true AND policyEvidenceAvailable = true AND gapMediaConcern and gapPolicyStrength are known" ;
    chpg:hasConclusion "gapDifference = gapMediaConcern - gapPolicyStrength" ;
    chpg:hasPolicyLogic "The raw score difference must be calculated only when both news and policy evidence are available." .

chpg:Rule_Final_06_GapSeverityCalculation rdf:type chpg:ReasoningRule ;
    rdfs:label "Final gap severity calculation rule" ;
    chpg:hasCondition "gapDifference is known" ;
    chpg:hasConclusion "If gapDifference <= 0 then gapSeverity = 0; if gapDifference > 0 then gapSeverity = gapDifference" ;
    chpg:hasPolicyLogic "Gap severity is reported from 0 to 3. A negative difference means no policy gap, not negative severity." .

chpg:Rule_Final_07_NoPolicyGapDetected rdf:type chpg:ReasoningRule ;
    rdfs:label "No policy gap detected rule" ;
    chpg:hasCondition "newsEvidenceAvailable = true AND policyEvidenceAvailable = true AND gapSeverity = 0 AND no strong ontology gap-type rule fires" ;
    chpg:hasConclusion "hasPolicyGapCoherenceStatus = NoPolicyGapDetected; gapType must be empty" ;
    chpg:hasPolicyLogic "When news and policy evidence are both present and policy response is equal to or stronger than news concern, the result is policy coherence unless a strong limitation is detected." .

chpg:Rule_Final_08_PartialPolicyCoherence rdf:type chpg:ReasoningRule ;
    rdfs:label "Partial policy coherence rule" ;
    chpg:hasCondition "newsEvidenceAvailable = true AND policyEvidenceAvailable = true AND gapSeverity = 0 AND one or more limitation rules fire" ;
    chpg:hasConclusion "hasPolicyGapCoherenceStatus = PartialPolicyCoherence OR PolicyLimitation" ;
    chpg:hasPolicyLogic "If scores are balanced but evidence shows missing monitoring, finance, target group, geography, or outcome evidence, the result is partial coherence or policy limitation, not a full policy gap." .

chpg:Rule_Final_09_MinorPolicyGap rdf:type chpg:ReasoningRule ;
    rdfs:label "Minor policy gap rule" ;
    chpg:hasCondition "newsEvidenceAvailable = true AND policyEvidenceAvailable = true AND gapSeverity = 1" ;
    chpg:hasConclusion "hasPolicyGapCoherenceStatus = PartialPolicyCoherence; classify only the strongest one or two directly supported gap types" ;
    chpg:hasPolicyLogic "A severity score of 1 indicates a minor or partial policy gap." .

chpg:Rule_Final_10_ModeratePolicyGap rdf:type chpg:ReasoningRule ;
    rdfs:label "Moderate policy gap rule" ;
    chpg:hasCondition "newsEvidenceAvailable = true AND policyEvidenceAvailable = true AND gapSeverity = 2" ;
    chpg:hasConclusion "hasPolicyGapCoherenceStatus = ModeratePolicyGap; classify only the strongest one or two directly supported gap types" ;
    chpg:hasPolicyLogic "A severity score of 2 indicates a moderate policy gap." .

chpg:Rule_Final_11_CriticalPolicyGap rdf:type chpg:ReasoningRule ;
    rdfs:label "Critical policy gap rule" ;
    chpg:hasCondition "newsEvidenceAvailable = true AND policyEvidenceAvailable = true AND gapSeverity = 3" ;
    chpg:hasConclusion "hasPolicyGapCoherenceStatus = CriticalPolicyGap; classify only the strongest one or two directly supported gap types" ;
    chpg:hasPolicyLogic "A severity score of 3 indicates a critical policy gap." .

chpg:Rule_Final_12_NoForcedGap rdf:type chpg:ReasoningRule ;
    rdfs:label "No forced gap rule" ;
    chpg:hasCondition "newsEvidenceAvailable = false OR policyEvidenceAvailable = false" ;
    chpg:hasConclusion "Do not classify DesignGap, ImplementationGap, CoverageGap, OutcomeGap, or EquityGap as confirmed policy gaps" ;
    chpg:hasPolicyLogic "Gap types require both news evidence and policy evidence. Missing evidence should be reported as missing evidence, not as a confirmed gap." .

chpg:Rule_Final_13_NoGapTypeForCoherence rdf:type chpg:ReasoningRule ;
    rdfs:label "No gap type for coherence rule" ;
    chpg:hasCondition "hasPolicyGapCoherenceStatus = NoPolicyGapDetected OR hasPolicyGapCoherenceStatus = PolicyOnlyAlignment OR hasPolicyGapCoherenceStatus = EvidenceInsufficient" ;
    chpg:hasConclusion "gapType must be empty" ;
    chpg:hasPolicyLogic "Coherence, policy-only alignment, and insufficient evidence statuses must not carry gap types." .

chpg:Rule_Final_14_GapTypeEvidenceRequirement rdf:type chpg:ReasoningRule ;
    rdfs:label "Gap type evidence requirement rule" ;
    chpg:hasCondition "The system proposes a gapType" ;
    chpg:hasConclusion "Each gapType must be supported by direct evidence from news, policy, or external memory" ;
    chpg:hasPolicyLogic "The system must not over-classify gaps. Gap types must be evidence-grounded." .

chpg:Rule_Final_15_MaxTwoGapTypes rdf:type chpg:ReasoningRule ;
    rdfs:label "Maximum two gap types rule" ;
    chpg:hasCondition "Multiple gap-type rules fire for one result" ;
    chpg:hasConclusion "Keep only one primary gap type and, if necessary, one secondary gap type" ;
    chpg:hasPolicyLogic "Each final result should report only the strongest one or two gap types to avoid over-classification." .

chpg:Rule_Final_16_NoRiskMixing rdf:type chpg:ReasoningRule ;
    rdfs:label "No risk mixing rule" ;
    chpg:hasCondition "A result contains multiple unrelated HealthRisk instances" ;
    chpg:hasConclusion "Split the result into separate assessment rows by HealthRisk" ;
    chpg:hasPolicyLogic "Dengue, heat stress, salinity, reproductive health, air pollution, and flood-related diarrhoeal disease should be assessed separately unless the guiding question explicitly asks for an overview." .

chpg:Rule_Final_17_FinalOutput rdf:type chpg:ReasoningRule ;
    rdfs:label "Final output rule" ;
    chpg:hasCondition "Assessment has evidence status, scores, WHO alignment, external memory status, and policy gap/coherence status" ;
    chpg:hasConclusion "Return risk, news score, policy score, gapDifference, gapSeverity, WHO alignment, policy gap/coherence status, primary gap type, secondary gap type if any, confidence score, freshness score, evidence priority, reasoning trace, and sources" ;
    chpg:hasPolicyLogic "The final result should be a traceable policy analysis output, not a forced gap statement." .

#################################################################
# 15. SHACL VALIDATION SHAPES
#################################################################

chpg:PolicyAssessmentShape rdf:type sh:NodeShape ;
    sh:targetClass chpg:PolicyAssessment ;
    sh:property [
        sh:path chpg:newsEvidenceAvailable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chpg:policyEvidenceAvailable ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chpg:hasPolicyGapCoherenceStatus ;
        sh:class chpg:GapStatus ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chpg:gapMediaConcern ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
    ] ;
    sh:property [
        sh:path chpg:gapPolicyStrength ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
    ] ;
    sh:property [
        sh:path chpg:gapDifference ;
        sh:datatype xsd:integer ;
        sh:minInclusive -3 ;
        sh:maxInclusive 3 ;
    ] ;
    sh:property [
        sh:path chpg:gapSeverity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
    ] .

chpg:PolicyGapShape rdf:type sh:NodeShape ;
    sh:targetClass chpg:PolicyGap ;
    sh:property [
        sh:path chpg:relatedRisk ;
        sh:class chpg:HealthRisk ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chpg:gapSeverity ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ;
        sh:maxInclusive 3 ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chpg:hasPolicyGapCoherenceStatus ;
        sh:class chpg:GapStatus ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path chpg:hasPrimaryGapType ;
        sh:class chpg:GapType ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path chpg:hasSecondaryGapType ;
        sh:class chpg:GapType ;
        sh:maxCount 1 ;
    ] .

chpg:PolicyMeasureShape rdf:type sh:NodeShape ;
    sh:targetClass chpg:PolicyMeasure ;
    sh:property [
        sh:path chpg:policyStrengthScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
    ] ;
    sh:property [
        sh:path chpg:whoAlignmentScore ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
    ] .

chpg:WorkflowRunShape rdf:type sh:NodeShape ;
    sh:targetClass chpg:WorkflowRun ;
    sh:property [
        sh:path chpg:hasWorkflowStep ;
        sh:minCount 3 ;
    ] ;
    sh:property [
        sh:path chpg:producesFinalResult ;
        sh:class chpg:FinalResult ;
        sh:minCount 1 ;
    ] .

