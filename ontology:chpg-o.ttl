chpg:WorkflowRun_001 rdf:type chpg:WorkflowRun ;
    rdfs:label "Workflow run for heat stress among outdoor workers" ;
    chpg:workflowDate "2026-06-26"^^xsd:date ;
    chpg:hasWorkflowStep chpg:Step1_NewsCheck_001 , chpg:Step2_PolicyCheck_001 , chpg:Step3_OntologyReasoning_001 , chpg:Step4_ExternalMemoryRecheck_001 ;
    chpg:producesFinalResult chpg:FinalResult_001 .

chpg:Step1_NewsCheck_001 rdf:type chpg:NewsEvidenceCheck ;
    chpg:stepOrder 1 ;
    chpg:checksNewsSource chpg:NewsArticle_N001 ;
    chpg:usesEvidenceClaim chpg:Claim_N001 ;
    chpg:nextStep chpg:Step2_PolicyCheck_001 .

chpg:Step2_PolicyCheck_001 rdf:type chpg:PolicyEvidenceCheck ;
    chpg:stepOrder 2 ;
    chpg:checksPolicySource chpg:PolicyDocument_P001 ;
    chpg:usesEvidenceClaim chpg:Claim_P001 ;
    chpg:nextStep chpg:Step3_OntologyReasoning_001 .

chpg:Step3_OntologyReasoning_001 rdf:type chpg:OntologyReasoningStep ;
    chpg:stepOrder 3 ;
    chpg:usesOntologyRule chpg:Rule_04_BasicGapDetection , chpg:Rule_05_GapDifferenceCalculation , chpg:Rule_06_GapSeverityNormalization , chpg:Rule_Final_10_ModeratePolicyGap , chpg:Rule_Final_15_MaxTwoGapTypes ;
    chpg:producesAssessment chpg:Assessment_HeatStress_OutdoorWorkers ;
    chpg:producesGap chpg:Assessment_HeatStress_OutdoorWorkers ;
    chpg:nextStep chpg:Step4_ExternalMemoryRecheck_001 .

chpg:Step4_ExternalMemoryRecheck_001 rdf:type chpg:ExternalMemoryRecheck ;
    chpg:stepOrder 4 ;
    chpg:checksExternalMemory chpg:EM_BD_02_OpEd2026_Risks , chpg:EM_BD_03_OpEd2026_ImplementationFinance .

chpg:FinalResult_001 rdf:type chpg:FinalResult ;
    chpg:finalizesAssessment chpg:Assessment_HeatStress_OutdoorWorkers ;
    chpg:finalizesGap chpg:Assessment_HeatStress_OutdoorWorkers ;
    chpg:hasEvidenceStatus chpg:ConfirmedEvidence ;
    chpg:finalResultText "Heat stress among outdoor workers is strongly reported in news evidence, weakly addressed in policy evidence, and supported by recent external memory. The ontology classifies this as a moderate policy gap with CoverageGap as the primary gap type and ImplementationGap as the secondary gap type under WHO C8." .

